<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iPadOS app-side DriverKit entitlement: allows this app to open
	     user clients to drivers (Boolean; replaces the macOS-only
	     userclient-access array). Same-team dexts need nothing more. -->
	<key>com.apple.developer.driverkit.communicates-with-drivers</key>
	<true/>
</dict>
</plist>
