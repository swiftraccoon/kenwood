<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Base DriverKit family entitlement. Required for any dext. -->
	<key>com.apple.developer.driverkit</key>
	<true/>

	<!-- USB transport entitlement. The development wildcard is a DICT
	     with idVendor = "*" (String), matching the shape the DriverKit
	     team provisioning profile grants. A bare <string>*</string> in
	     the array does NOT match the profile and installd rejects the
	     dext with 0xe8008015 "valid provisioning profile not found"
	     (hardware-verified 2026-07-19). Available to any paid developer
	     account with no Apple approval. Distribution builds swap the
	     "*" for <integer>8550</integer> after the System Extensions
	     entitlement request is approved. -->
	<key>com.apple.developer.driverkit.transport.usb</key>
	<array>
		<dict>
			<key>idVendor</key>
			<string>*</string>
		</dict>
	</array>
</dict>
</plist>
