 *
 * DriverKit dext for the TH-D75's CDC Data interface
 * (bInterfaceNumber 1): bulk IN/OUT byte pump exposed to the app via
 * LodestarUserClient (doorbell + drain protocol).
 */

#ifndef LodestarUSBSerialDriver_h
#define LodestarUSBSerialDriver_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOUserClient.iig>
#include <USBDriverKit/IOUSBHostInterface.iig>
#include <USBDriverKit/IOUSBHostPipe.iig>

class LodestarUserClient;

class LodestarUSBSerialDriver: public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;

    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient **userClient) override;

    /// Bulk-IN completion. Re-armed from within until kIOReturnAborted.
    virtual void BulkInComplete(OSAction *action,
                                IOReturn status,
                                uint32_t actualByteCount,
                                uint64_t completionTimestamp) TYPE(IOUSBHostPipe::CompleteAsyncIO);

    /// Bulk-OUT completion. Sends the next queued chunk, if any.
    virtual void BulkOutComplete(OSAction *action,
                                 IOReturn status,
                                 uint32_t actualByteCount,
                                 uint64_t completionTimestamp) TYPE(IOUSBHostPipe::CompleteAsyncIO);

    // ---- Cross-object entry points (called from LodestarUserClient's
    // dispatch queue; each serializes onto the driver queue). ----

    /// Queue bytes for bulk OUT. kIOReturnNoResources = queue full.
    kern_return_t EnqueueWrite(const uint8_t *data, size_t length) LOCALONLY;

    /// Copy out up to `capacity` buffered RX bytes. Never blocks;
    /// *actual == 0 means empty.
    kern_return_t CopyBufferedBytes(uint8_t *out, size_t capacity, size_t *actual) LOCALONLY;

    /// Arm the one-shot doorbell. Replaces any armed doorbell (the old
    /// action is completed kIOReturnAborted). Fires immediately when
    /// the RX ring is already non-empty.
    void RegisterDoorbell(LodestarUserClient *client, OSAction *action) LOCALONLY;

    /// Detach a dying user client: abort its doorbell, forget it.
    void UnregisterUserClient(LodestarUserClient *client) LOCALONLY;

    /// out[4] = { rxBuffered, rxOverflowBytes, linkUp, doorbellArmed }.
    void CopyStatus(uint64_t out[4]) LOCALONLY;

    /// Copy the diagnostic event ring (LodestarLogEntry structs, oldest
    /// first) into `out`. The ring makes dext internals readable from
    /// the app with no Console access — every lifecycle and I/O event
    /// leaves a breadcrumb here.
    void CopyLogEntries(uint8_t *out, size_t capacity, size_t *actual) LOCALONLY;
};

#endif /* LodestarUSBSerialDriver_h */
