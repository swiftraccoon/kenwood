 *
 * IOUserClient for LodestarUSBSerialDriver. Selectors (keep in sync
 * with `USBSerialSelector` in Shared/Transport/USBSerialLink.swift):
 *   0 write (struct in ≤4096): kIOReturnNoResources = backpressure
 *   1 read  (struct out ≤4096): 0 bytes = empty, never blocks
 *   2 armDoorbell (async completion): one-shot data-available doorbell
 *   3 status (4 scalars out)
 *   4 copyLog (struct out ≤4096): diagnostic event ring, oldest first
 */

#ifndef LodestarUserClient_h
#define LodestarUserClient_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOUserClient.iig>

class LodestarUSBSerialDriver;

class LodestarUserClient: public IOUserClient
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;

    virtual kern_return_t ExternalMethod(uint64_t selector,
                                         IOUserClientMethodArguments *arguments,
                                         const IOUserClientMethodDispatch *dispatch,
                                         OSObject *target,
                                         void *reference) override;

    /// Complete an armed doorbell action. Called by the driver (on the
    /// driver queue): kIOReturnSuccess = data available,
    /// kIOReturnAborted = teardown/re-arm.
    void FireDoorbell(OSAction *action, IOReturn status) LOCALONLY;

    // Static dispatch-table handlers.
    static kern_return_t HandleWrite(OSObject *target, void *reference,
                                     IOUserClientMethodArguments *arguments) LOCALONLY;
    static kern_return_t HandleRead(OSObject *target, void *reference,
                                    IOUserClientMethodArguments *arguments) LOCALONLY;
    static kern_return_t HandleArmDoorbell(OSObject *target, void *reference,
                                           IOUserClientMethodArguments *arguments) LOCALONLY;
    static kern_return_t HandleStatus(OSObject *target, void *reference,
                                      IOUserClientMethodArguments *arguments) LOCALONLY;
    static kern_return_t HandleCopyLog(OSObject *target, void *reference,
                                       IOUserClientMethodArguments *arguments) LOCALONLY;
};

#endif /* LodestarUserClient_h */
