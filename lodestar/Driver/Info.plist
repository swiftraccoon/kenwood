<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Lodestar TH-D75 Driver</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>DEXT</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>OSBundleUsageDescription</key>
	<string>Lodestar uses this driver to communicate with your Kenwood TH-D75 transceiver over USB-C.</string>

	<key>IOKitPersonalities</key>
	<dict>
		<key>LodestarTHD75</key>
		<dict>
			<key>CFBundleIdentifier</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

			<!-- Kernel-side stub class for user-space DriverKit drivers. -->
			<key>IOClass</key>
			<string>IOUserService</string>

			<!-- The user-space class that runs. Must match the .iig. -->
			<key>IOUserClass</key>
			<string>LodestarUSBSerialDriver</string>

			<key>IOUserServerName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

			<!-- Match the CDC *Data* interface (bInterfaceNumber 1) of
			     the TH-D75: that's where the bulk IN/OUT endpoints
			     live; the class 02/02 control interface has only an
			     interrupt endpoint (topology hardware-verified via
			     ioreg 2026-07-19). The key combo
			     idVendor+idProduct+bConfigurationValue+bInterfaceNumber
			     is a valid USB Common Class match at probe score 90000,
			     outranking any class-based system driver. Interfaces
			     2-3 (USB audio) stay with the system's audio stack.
			     VID 0x2166 = 8550, PID 0x9023 = 36899. -->
			<key>IOProviderClass</key>
			<string>IOUSBHostInterface</string>
			<key>idVendor</key>
			<integer>8550</integer>
			<key>idProduct</key>
			<integer>36899</integer>
			<key>bConfigurationValue</key>
			<integer>1</integer>
			<key>bInterfaceNumber</key>
			<integer>1</integer>

			<!-- Instantiated by NewUserClient's Create() call, which
			     names this key. -->
			<key>LodestarUserClientProperties</key>
			<dict>
				<key>IOClass</key>
				<string>IOUserUserClient</string>
				<key>IOUserClass</key>
				<string>LodestarUserClient</string>
			</dict>
		</dict>

		<!-- Companion personality: claim the CDC ACM *control*
		     interface (bInterfaceNumber 0) and service its interrupt
		     endpoint, mirroring a standard host ACM stack (macOS runs
		     AppleUSBACM here). Hardware evidence 2026-07-19: with the
		     control interface unclaimed the radio ACKs bulk-OUT CAT
		     bytes but never transmits on bulk IN. -->
		<key>LodestarTHD75Comm</key>
		<dict>
			<key>CFBundleIdentifier</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>IOClass</key>
			<string>IOUserService</string>
			<key>IOUserClass</key>
			<string>LodestarUSBCommDriver</string>
			<key>IOUserServerName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>IOProviderClass</key>
			<string>IOUSBHostInterface</string>
			<key>idVendor</key>
			<integer>8550</integer>
			<key>idProduct</key>
			<integer>36899</integer>
			<key>bConfigurationValue</key>
			<integer>1</integer>
			<key>bInterfaceNumber</key>
			<integer>0</integer>
		</dict>
	</dict>
</dict>
</plist>
