#ifndef AzimuthUSBSerialDriver_h
#define AzimuthUSBSerialDriver_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOUserClient.iig>
#include <USBDriverKit/IOUSBHostInterface.iig>
#include <USBDriverKit/IOUSBHostPipe.iig>

class AzimuthUserClient;

class AzimuthUSBSerialDriver: public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;
    virtual kern_return_t NewUserClient(uint32_t type,
                                        IOUserClient **userClient) override;

    virtual void BulkInComplete(OSAction *action,
                                IOReturn status,
                                uint32_t actualByteCount,
                                uint64_t completionTimestamp)
        TYPE(IOUSBHostPipe::CompleteAsyncIO);
    virtual void BulkOutComplete(OSAction *action,
                                 IOReturn status,
                                 uint32_t actualByteCount,
                                 uint64_t completionTimestamp)
        TYPE(IOUSBHostPipe::CompleteAsyncIO);

    kern_return_t EnqueueWrite(const uint8_t *data, size_t length) LOCALONLY;
    /// ABI v2: apply CDC line coding. Only 9600 and 115200 are accepted.
    kern_return_t SetBaudRate(uint32_t baudRate) LOCALONLY;
    kern_return_t CopyBufferedBytes(uint8_t *out, size_t capacity,
                                    size_t *actual) LOCALONLY;
    kern_return_t RegisterDoorbell(AzimuthUserClient *client,
                                   OSAction *action) LOCALONLY;
    void UnregisterUserClient(AzimuthUserClient *client) LOCALONLY;
    void CopyStatus(uint64_t out[4]) LOCALONLY;
    void CopyLogEntries(uint8_t *out, size_t capacity,
                        size_t *actual) LOCALONLY;
};

#endif /* AzimuthUSBSerialDriver_h */
